# ============================================================
# OBRIGATÓRIO — preencha antes de subir
# ============================================================

# MongoDB Atlas (free tier M0)
# Crie em https://cloud.mongodb.com → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/spectreapi?retryWrites=true&w=majority

# Token de dono da API (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
API_ADMIN_TOKEN=troque_por_um_token_seguro_aqui

# Salt para hash do HWID (gere com: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))")
HWID_SALT=troque_por_salt_aleatorio_aqui

# ============================================================
# PORTA (Railway/Render injetam PORT automaticamente)
# ============================================================
PORT=3000

# ============================================================
# CORS — URL do seu painel admin (Next.js)
# Exemplo Railway: https://meu-admin.up.railway.app
# ============================================================
ALLOWED_ORIGIN=http://localhost:3000

# ============================================================
# COOKIES (painel admin)
# Em produção: PORTAL_COOKIE_SECURE=1, PORTAL_COOKIE_SAMESITE=none
# ============================================================
PORTAL_COOKIE_SECURE=0
PORTAL_COOKIE_SAMESITE=lax
PORTAL_SESSION_HOURS=168
ADMIN_SESSION_HOURS=12

# ============================================================
# HASHES (opcional — deixe vazio para usar padrão)
# ============================================================
PRODUCT_HASH_SALT=
KEY_SCOPE_SALT=

# ============================================================
# MANUTENÇÃO
# ============================================================
MAINTENANCE_MODE=0
MAINTENANCE_MESSAGE=Sistema em manutenção. Tente novamente em breve.

# ============================================================
# LOGS (webhook Discord para notificações — OPCIONAL)
# Deixe em branco para desativar
# ============================================================
LOG_WEBHOOK_URL=
LOG_WEBHOOK_MIN_LEVEL=WARN
LOG_WEBHOOK_USERNAME=SpectreAuth
LOG_WEBHOOK_SENSITIVE=0

# ============================================================
# BILLING Efí (OPCIONAL — para pagamentos)
# ============================================================
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERT_PATH=
EFI_SANDBOX=1
EFI_WEBHOOK_SECRET=
PUBLIC_API_BASE_URL=https://sua-api.railway.app
BILLING_PRICE_PER_DAY_CENTS=100

# ============================================================
# PREFIXO PADRÃO DAS KEYS GERADAS
# ============================================================
KEY_PREFIX=SPECTREs

# ============================================================
# PROXY (Railway/Render rodam atrás de proxy reverso)
# ============================================================
TRUST_PROXY=1
